msgid "``SIMULATION_FAILED``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:396
msgid "The solver failed. Check ``diagnostics`` first."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:397
msgid "``EXTRACTION_FAILED``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:398
msgid ""
"A post-extraction task returned ``None``. ``error`` names which ones; "
"``results`` still holds the tasks that did succeed."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:400
msgid "``MONOLITHIC_SCRIPT_FAILED``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:401
msgid "A monolithic script exited non-zero."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:402
msgid "``JSON_DECODE_ERROR``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:403
msgid ""
"A script's output could not be parsed — usually missing "
"``===ABQ_RESULT_BEGIN===`` / ``===ABQ_RESULT_END===`` markers."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:405
msgid "``SCRIPT_ERROR``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:406
msgid "An unhandled exception inside a hook or monolithic script."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:407
msgid "``UNKNOWN_ERROR``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:408
msgid ""
"An exception escaped the worker. ``error`` holds the traceback — this one"
" is a bug report, not a modelling problem."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:410
msgid "``UNKNOWN``"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:411
msgid "A workflow returned no ``status`` at all. Should not occur."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:413
msgid ""
"In-progress values (``PREPARING``, ``SIMULATING``, ``EXTRACTING``) and "
"per-phase success values (``PREPARATION_SUCCESS``, ``COMPILED``, "
"``PASSED``, …) appear inside ``phases``, never as a final ``status``."
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:420
msgid "``diagnostics`` keys"
msgstr ""

#: ../../../source/user_guide/basic_batch.rst:422
msgid ""
"Diagnostics are harvested after *every* solver run, but only **attached "
"to the outcome when the run was not clean**."
msgstr ""

