msgstr ""

#: ABQflow.datkit.parse:16 of
msgid ""
"``'all'`` (default), ``'first'``, ``'last'``, a positive increment "
"number, a negative index from the end, or a sequence.  ``'first'``, "
"``'last'``, positive numbers and negative indices are applied *while "
"streaming*, so peak memory stays at one increment however long the "
"analysis ran."
msgstr ""

#: ABQflow.datkit.parse:21 of
msgid "keep_rows"
msgstr ""

#: ABQflow.datkit.parse:-1 ABQflow.datkit.to_rows:-1 of
msgid "bool"
msgstr ""

#: ABQflow.datkit.parse:22 of
msgid "``False`` discards row data, keeping only ``summary`` and ``shape``."
msgstr ""

#: ABQflow.datkit.parse:23 of
msgid "max_rows"
msgstr ""

#: ABQflow.datkit.parse:-1 of
msgid "int or None"
msgstr ""

#: ABQflow.datkit.parse:24 of
msgid "Cap the rows retained per table; capped tables carry ``truncated=True``."
msgstr ""

#: ABQflow.datkit.parse:28 ABQflow.hookkit.field:18 of
msgid "Returns"
msgstr ""

#: ABQflow.datkit.parse:29 ABQflow.hookkit.field:-1 of
msgid "dict"
msgstr ""

#: ABQflow.datkit.parse:30 of
#, python-brace-format
msgid ""
"``{'path', 'completed', 'terminator', 'steps', 'increments', "
"'increment_count', 'table_count', 'warnings', ...}``. ``increment_count``"
" and ``table_count`` describe the *file* — every increment, and every "
"table passing *kinds* / *set_name* / *steps* — not the subset "
"*increments* retained, so a log line built from them still says how big "
"the run was."
msgstr ""

#: ABQflow.datkit.scan_status:1 of
msgid "Read only the tail of *path* and report how the analysis ended."
msgstr ""

#: ABQflow.datkit.scan_status:3 of
msgid ""
"``ANALYSIS COMPLETE`` is printed whether or not the step converged, so it"
" is deliberately not consulted: ``completed`` follows ``THE ANALYSIS HAS "
"BEEN COMPLETED`` alone."
msgstr ""

#: ABQflow.datkit.select_increments:1 of
msgid "Pick increments out of a parsed *doc*."
msgstr ""

#: ABQflow.datkit.select_increments:3 of
msgid ""
"*step* is ``None`` (all), an int, ``'last'``, or a sequence. *increment* "
"is ``'all'``, ``'first'``, ``'last'``, a positive increment number, a "
"negative index from the end, or a sequence of either."
msgstr ""

