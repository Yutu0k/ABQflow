msgid "Strategies run before the solver (e.g. property extraction from INP)."
msgstr ""

#: ABQflow.core.strategies.ModularWorkflowStrategy:24 of
msgid "post_extraction_strategies"
msgstr ""

#: ABQflow.core.strategies.ModularWorkflowStrategy:25 of
msgid "Strategies run after the solver (e.g. result extraction from ODB)."
msgstr ""

