msgstr ""

#: ABQflow.core.runner.AbaqusRunner:5 of
msgid "**abqpy installed** — uses plain ``python`` (abqpy wraps the Abaqus API)."
msgstr ""

#: ABQflow.core.runner.AbaqusRunner:6 of
msgid "**Needs CAE kernel** (``mdb``) — uses ``abaqus cae noGUI=<script>``."
msgstr ""

#: ABQflow.core.runner.AbaqusRunner:7 of
msgid "**Only needs odbAccess** — uses ``abaqus python <script>``."
msgstr ""

