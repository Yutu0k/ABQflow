msgstr ""

#: ABQflow.core.strategies.OdbExtractionStrategy:1 of
msgid "Extract results from the ODB file via hook scripts."
msgstr ""

#: ABQflow.core.strategies.OdbExtractionStrategy:3 of
msgid ""
"Runs in the ``odbAccess`` environment (``abaqus python``), NOT the CAE "
"kernel.  Each hook script receives ``--odb_path`` as a common argument "
"and a JSON task list via ``--tasks_json``."
msgstr ""

#: ABQflow.core.strategies.DatExtractionStrategy:20
#: ABQflow.core.strategies.ModelPropertiesExtractionStrategy:9
#: ABQflow.core.strategies.OdbExtractionStrategy:9 of
msgid "hooks"
msgstr ""

