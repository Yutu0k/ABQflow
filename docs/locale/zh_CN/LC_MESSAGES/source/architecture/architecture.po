#~ msgid "**Abaqus license token formula**: a job using *n* CPU cores consumes"
#~ msgstr ""

#~ msgid "T(n) = \\lceil 5 \\cdot n^{0.422} \\rceil"
#~ msgstr ""

#~ msgid ""
#~ "Token counts are sublinear — 1→5, "
#~ "2→7, 4→9, 8→13, 16→17 — which "
#~ "means widening a job costs far "
#~ "fewer tokens than running more jobs."
#~ msgstr ""

#~ msgid "**Parallelism limits:**"
#~ msgstr ""

#~ msgid ""
#~ "P_{cpu}     &= \\lfloor (C - R) / c \\rfloor \\\\\n"
#~ "P_{license} &= \\lfloor L / T(c) \\rfloor \\\\\n"
#~ "P_{actual}  &= \\max(1, \\min(P_{req}, P_{license}))"
#~ msgstr ""

#~ msgid ""
#~ "where *C* = physical cores, *R* ="
#~ " reserved cores (default 1), *c* ="
#~ " cores per job, and *L* = "
#~ "available tokens.  :math:`P_{cpu}` is computed"
#~ " only to decide whether to emit "
#~ "the CPU-oversubscription warning — it"
#~ " does not bound :math:`P_{actual}`."
#~ msgstr ""

