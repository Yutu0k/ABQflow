    "cards": [
        {
            "dot": "cyan",
            "title": "编排与并发",
            "items": [
                "plan() 只读判重，prepare() 才落盘",
                "assign_hosts 按 weight 加权分派",
                "capacity 受 license_tokens 硬顶",
                "每机 Semaphore 独立限流，单作业失败不拖垮整批"
            ]
        },
        {
            "dot": "emerald",
            "title": "注册表决定策略",
            "items": [
                "kind → PREPARATION_REGISTRY 工厂",
                "source → EXTRACTION_REGISTRY 工厂",
                "连续同源分组，保留钩子声明顺序",
                "register_* 运行时扩展，不改框架代码"
            ]
        },
        {
            "dot": "amber",
            "title": "策略驱动 Runner",
            "items": [
                "execute(ctx, runner, logger) 三参注入",
                "解释器：cae noGUI / abaqus python / host",
                "map_context 重写远端路径，命令零改动",
                "分离启动 + .abqflow.rc 哨兵判完成"
            ]
        },
        {
            "dot": "violet",
            "title": "钩子契约与诊断",
            "items": [
                "hookkit 管协议：argparse + 哨兵 JSON",
                "超阈值自动落 CSV sidecar 并校验信封",
                "datkit 解析 .dat，跑宿主 Python 免许可证",
                ".sta 的 COMPLETED 才是成功凭证"
            ]
        }
    ]
